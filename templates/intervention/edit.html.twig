{% extends 'base.html.twig' %}

{% block title %}Modifier l’intervention
{% endblock %}

{% block body %}
	<div class="container my-4">
		<h1 class="mb-4">
			Modifier une intervention</h1>

		{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

		<div
			class="row g-4">
			<!--  Colonne gauche : formulaire -->
			<div class="col-md-4">
				<div class="card shadow-sm p-3 h-100">
					<h4 class="mb-3">Informations</h4>
					{{ form_row(form.clientNom) }}
					{{ form_row(form.reference) }}
					{{ form_row(form.adresse) }}
					{{ form_row(form.demande) }}
					{{ form_row(form.detail) }}

					{# nouveaux champs #}
					{{ form_row(form.dateIntervention) }}
					{{ form_row(form.heureDebut) }}
					{{ form_row(form.heureFin) }}
					{{ form_row(form.technicien) }}
				</div>
			</div>

			<!-- Colonne droite : aperçu des documents -->
			<div class="col-md-8">
				<div class="card shadow-sm p-3 h-100">
					<h4 class="mb-3">Document affiché</h4>

					{% if intervention.documents|length > 0 %}
						{% for document in intervention.documents %}
							<div class="mb-3 border p-2 rounded">
								{% if document.path ends with '.pdf' %}
									<iframe src="{{ asset(document.path) }}" width="100%" height="700px" class="rounded border"></iframe>
								{% elseif document.path matches '/\.(jpg|jpeg|png|gif)$/i' %}
									<img src="{{ asset(document.path) }}" alt="aperçu" class="img-fluid rounded shadow-sm"/>
								{% endif %}
							</div>
						{% endfor %}
					{% else %}
						<p class="text-muted fst-italic">Aucun document n’est encore lié à cette intervention.</p>
					{% endif %}
				</div>
			</div>
		</div>

		<!--  Zone inférieure : upload documents -->
		<div class="row mt-4">
			<div class="col-12">
				<div class="card shadow-sm p-3">
					<h4 class="mb-3">Ajouter / Modifier un document</h4>

					<div id="documents-wrapper" data-prototype="{{ form_widget(form.documents.vars.prototype)|e('html_attr') }}">
						{% for docForm in form.documents %}
							<div class="document-item border rounded p-3 mb-3">
								{{ form_row(docForm.file) }}
								{{ form_row(docForm.type) }}

								<div class="preview mt-2">
									<p class="text-muted fst-italic">Aperçu du document ici après sélection.</p>
								</div>

								<button type="button" class="btn btn-outline-danger btn-sm remove-document">
									Supprimer
								</button>
							</div>
						{% endfor %}
					</div>

					<button type="button" id="add-document" class="btn btn-outline-secondary mt-2">
						+ Ajouter un document
					</button>
				</div>
			</div>
		</div>

		<div class="mt-4 text-end">
			<button type="submit" class="btn btn-primary">
				Enregistrer les modifications</button>
		</div>

		{{ form_end(form) }}
	</div>

	<script>
		// === JS pour gérer ajout / suppression de documents ===
const collectionHolder = document.getElementById('documents-wrapper');
const addButton = document.getElementById('add-document');
collectionHolder.dataset.index = collectionHolder.querySelectorAll('.document-item').length;

addButton.addEventListener('click', () => {
const prototype = collectionHolder.dataset.prototype;
const index = collectionHolder.dataset.index;
const newForm = prototype.replace(/__name__/g, index);
collectionHolder.dataset.index ++;

const item = document.createElement('div');
item.classList.add('document-item', 'border', 'rounded', 'p-3', 'mb-3');
item.innerHTML = newForm + `
            <div class="preview mt-2">
                <p class="text-muted fst-italic">Aperçu du document ici après sélection.</p>
            </div>
            <button type="button" class="btn btn-outline-danger btn-sm remove-document">
                Supprimer
            </button>`;
collectionHolder.appendChild(item);
});

document.addEventListener('change', (e) => {
if (e.target.matches('.document-item input[type="file"]')) {
const input = e.target;
const previewDiv = input.closest('.document-item').querySelector('.preview');
const file = input.files[0];
if (file) {
const reader = new FileReader();
reader.onload = function (e) {
if (file.type === 'application/pdf') {
previewDiv.innerHTML = `<iframe src="${
e.target.result
}" width="100%" height="400px"></iframe>`;
} else if (file.type.startsWith('image/')) {
previewDiv.innerHTML = `<img src="${
e.target.result
}" class="img-fluid"/>`;
}
}
reader.readAsDataURL(file);
} else {
previewDiv.innerHTML = '<p class="text-muted fst-italic">Aperçu du document ici après sélection.</p>';
}
}
});

document.addEventListener('click', (e) => {
if (e.target && e.target.classList.contains('remove-document')) {
e.target.closest('.document-item').remove();
}
});
	</script>
{% endblock %}
