{% extends 'base.html.twig' %}

{% block title %}Interventions
{% endblock %}

{% block body %}
	<h1 class="mb-4">Liste des interventions en cours</h1>

	<div class="mb-3">
		<a class="btn btn-primary" href="{{ path('app_intervention_new') }}">Créer une nouvelle intervention</a>
		<a class="btn btn-secondary" href="{{ path('app_intervention_search') }}">Recherche</a>
		{#}test modal {#}
		<button class="btn btn-success" onclick="openGlobalModal({
				            title: 'Test modal universelle',
				            body: '<div class=\'p-4\'>🎉 La modal fonctionne !</div>'
				        })">
			Tester la modal
		</button>

	</div>

	<table class="table table-hover table-custom ">
		<thead class="table-dark">
			<tr>
				<th>Créée le</th>
				<th>Client</th>
				<th>Référence</th>
				<th>Adresse</th>
				<th>Documents liés</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			{% for intervention in interventions %}
				<tr>
					<td>
						<small class="text-muted">
							{{ intervention.createdAt|date('d/m/Y H:i') }}
						</small>
					</td>
					<td>{{ intervention.clientNom }}</td>
					<td>{{ intervention.reference }}</td>
					<td>{{ intervention.adresse }}</td>

					{# Documents liés #}
					<td>
						{% if intervention.documents|length > 0 %}
							<ul class="list-unstyled mb-0">
								{% for doc in intervention.documents %}
									<li>
										<a href="#" class="open-pdf" data-url="{{ asset(doc.path) }}" data-title="{{ doc.originalName ?: 'Document joint' }}">
											{{ doc.originalName ?: 'Document joint' }}
										</a>
									</li>
								{% endfor %}
							</ul>
						{% else %}
							<span class="text-muted fst-italic">Aucun document</span>
						{% endif %}
					</td>

					{# Actions #}
					<td>
						<a class="btn btn-sm btn-outline-primary" href="{{ path('app_intervention_show', {'id': intervention.id}) }}">
							Voir
						</a>
						<a class="btn btn-sm btn-outline-secondary" href="{{ path('app_intervention_edit', {'id': intervention.id}) }}">
							Éditer
						</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="6" class="text-center text-muted">
						Aucune intervention trouvée.
					</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

{% endblock %}
