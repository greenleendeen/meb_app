{% extends 'base.html.twig' %}

{% block title %}Recherche interventions
{% endblock %}

{% block body %}
	<div class="container mt-4">

		<h1 class="mb-4">Recherche d'interventions</h1>

		{# ==== RECHERCHE RAPIDE ==== #}
		<div class="card shadow-sm mb-4">
			<div class="card-body">
				<form method="get" action="{{ path('app_intervention_search') }}">
					{{ form_row(form.reference) }}
					<button class="btn btn-primary">Rechercher</button>
				</form>
			</div>

			<div class="card-footer text-end">
				<a class="btn btn-link" data-bs-toggle="collapse" href="#expertPanel">
					⬇ Recherche experte (filtres avancés)
				</a>
			</div>
		</div>

		{# ==== 🎛 RECHERCHE EXPERTE ==== #}
		<div id="expertPanel" class="collapse">

			<div class="card shadow-sm mb-4">
				<div class="card-body">
					{{ form_start(form, { method:'GET' }) }}

					<div class="row g-3">


						<div class="col-md-4">
							{{ form_row(form.adresse) }}
						</div>

						<div class="col-md-4">
							{{ form_row(form.technicien) }}
						</div>

						<div class="col-md-4">
							{{ form_row(form.typeDocument) }}
						</div>

					</div>

					<div class="mt-3 text-end">
						<button class="btn btn-success px-4">Appliquer les filtres</button>
					</div>

					{{ form_end(form) }}
				</div>
			</div>

		</div>

		{# ====  RESULTATS ==== #}
		<div class="card shadow-sm">
			<div class="card-header">
				<strong>Résultats :
					{{ total }}</strong>
			</div>

			<div class="card-body p-0">

				{% if results is empty %}
					<div class="p-4 text-center text-muted">
						Aucun résultat trouvé…
					</div>

				{% else %}

					<table class="table table-striped mb-0">
						<thead class="table-light">
							<tr>
								<th>Référence</th>
								<th>Client</th>
								<th>Adresse</th>
								<th>Techniciens</th>
								<th>Documents</th>
								<th></th>
							</tr>
						</thead>

						<tbody>
							{% for i in results %}
								<tr>
									<td>
										<strong>{{ i.reference }}</strong>
									</td>
									<td>{{ i.clientNom }}</td>
									<td>{{ i.adresse }}</td>

									<td>
										{% if i.technicien %}
											<span class="badge" style="background: {{ i.technicien.couleur }}">
												{{ i.technicien.nom }}
											</span>
										{% else %}
											<span class="text-muted">Aucun</span>
										{% endif %}
									</td>

									<td>
										{% for d in i.documents %}
											<span class="badge bg-secondary">
												{{ d.type ? d.type.label() : 'Type non défini' }}
											</span>
										{% endfor %}
										
										{% for d in i.documents %}
											<span class="badge bg-secondary">{{ d.type.label() }}</span>
										{% endfor %}
									</td>

									<td class="text-end">
										<a href="{{ path('app_intervention_show', { id:i.id }) }}" class="btn btn-sm btn-outline-primary">
											Ouvrir
										</a>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>

				{% endif %}
			</div>

			{# ==== PAGINATION ==== #}
			<div class="card-footer text-center">

				{% if pages > 1 %}
					<nav>
						<ul
							class="pagination justify-content-center">

							{# Précédent #}
							<li class="page-item {% if page == 1 %}disabled{% endif %}">
								<a class="page-link" href="{{ path('app_intervention_search', app.request.query.all | merge({'page': page - 1})) }}">
									&laquo;
								</a>
							</li>

							{# Pages #}
							{% for p in 1..pages %}
								<li class="page-item {% if p == page %}active{% endif %}">
									<a class="page-link" href="{{ path('app_intervention_search', app.request.query.all | merge({'page': p})) }}">
										{{ p }}
									</a>
								</li>
							{% endfor %}

							{# Suivant #}
							<li class="page-item {% if page == pages %}disabled{% endif %}">
								<a class="page-link" href="{{ path('app_intervention_search', app.request.query.all | merge({'page': page + 1})) }}">
									&raquo;
								</a>
							</li>

						</ul>
					</nav>
				{% endif %}
			</div>

		</div>

	</div>
{% endblock %}
