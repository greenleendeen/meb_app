{% extends 'base.html.twig' %}

{% block title %}Créer une intervention{% endblock %}

{% block body %}
<div class="container mx-auto mt-4 p-4 bg-white rounded-xl shadow">
    <h1 class="text-2xl font-bold mb-4">Planifier une nouvelle intervention</h1>

    <div class="mb-4">
        <a href="{{ path('app_intervention_index') }}" class="btn btn-secondary">← Retour à la liste</a>
        <a href="{{ path('app_home') }}" class="btn btn-light ml-2">Accueil</a>
    </div>

    {{ form_start(form) }}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {{ form_row(form.reference, {'label': 'Titre de l’intervention'}) }}
     <!-- ici j'ai supprimé le form data -->
            {{ form_row(form.clientNom, {'label': 'Client concerné'}) }}
            {{ form_row(form.demande, {'label': 'Travaux à réaliser'}) }}
            {{ form_row(form.detail, {'label': 'Détails complémentaires'}) }}
        </div>

        <div class="mt-6">
            <button type="submit" class="btn btn-primary">💾 Enregistrer</button>
        </div>
    {{ form_end(form) }}

    <hr class="my-6">

    <h2 class="text-xl font-semibold mb-2">Calendrier de planification</h2>
    <div id="calendar" class="border rounded-lg p-3"></div>
</div>
{% endblock %}
