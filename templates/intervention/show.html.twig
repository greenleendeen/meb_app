{% extends 'base.html.twig' %}

{% block title %}Détails de l'intervention{% endblock %}

{% block body %}

<div class="container mt-4 p-4 bg-white">

    {# HEADER #}
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <h5>Détails de l'intervention</h5>

        <div class="d-flex gap-2">
            <a href="{{ path('app_home') }}" class="btn btn-primary"> Retour à l'accueil</a>
            <a href="{{ path('app_intervention_edit', {'id': intervention.id}) }}" class="btn btn-primary">Modifier</a>
            <button onclick="window.print()" class="btn btn-outline-primary">🖨️ PDF</button>
        </div>
    </div>

    {# INFOS INTERVENTION #}
    <div class="card p-4 mb-4">
        <div class="row g-4">

            <div class="col-md-6">
                <h5>Informations</h5>

                <p><strong>Référence :</strong> {{ intervention.reference }}</p>
                <p><strong>Client :</strong> {{ intervention.clientNom }}</p>
                <p><strong>Adresse :</strong> {{ intervention.adresse }}</p>
            </div>

            <div class="col-md-6">
                <h5>Planification</h5>

                <p><strong>Technicien :</strong> {{ intervention.technicien.nom ?? '-' }}</p>
                <p><strong>Date :</strong> {{ intervention.dateIntervention ? intervention.dateIntervention|date('d/m/Y') : '-' }}</p>

                <p>
                    <strong>Heure :</strong>
                    {% if intervention.heureDebut and intervention.heureFin %}
                        {{ intervention.heureDebut|date('H:i') }} - {{ intervention.heureFin|date('H:i') }}
                    {% else %}
                        -
                    {% endif %}
                </p>
            </div>

        </div>
    </div>

    {# DEMANDE #}
    <div class="card p-4 mb-4">
        <h5>Demande</h5>
        <p class="mb-0">{{ intervention.demande ?: '-' }}</p>
    </div>

</div>

{# ========================= #}
{# DOCUMENTS INTERVENTION    #}
{# ========================= #}

<div class="container">
<div class="card p-4 mb-4 no-print">
    <h5>Documents</h5>

    {% if intervention.documents|length > 0 %}

        {% set grouped = {} %}

        {% for doc in intervention.documents %}
            {% set key = doc.type.value %}
            {% set grouped = grouped|merge({
                (key): (grouped[key]|default([]))|merge([doc])
            }) %}
        {% endfor %}

        {% for type, docs in grouped %}
            <div class="mb-3">
                <h6 class="text-primary">{{ docs[0].type.label }}</h6>

                <ul class="list-unstyled ms-3">
                    {% for doc in docs %}
                        <li>
                            <a href="{{ asset(doc.path) }}" target="_blank">
                                {{ doc.originalName ?: doc.filename }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}

    {% else %}
        <p class="text-muted">Aucun document</p>
    {% endif %}
</div>
</div>

{# ========================= #}
{# COMPTE RENDUS            #}
{# ========================= #}

<div class="container">

<div class="card p-4 mb-4 no-print">
    <div class="d-flex justify-content-between align-items-center">
        <h5>Comptes rendus</h5>

        <button class="btn btn-outline-primary"
                data-bs-toggle="modal"
                data-bs-target="#addCompteRenduModal">
            + Ajouter
        </button>
    </div>

    {% if intervention.compteRendus is empty %}

        <p class="text-muted mt-3">Aucun compte rendu</p>

    {% else %}

        {% for cr in intervention.compteRendus %}

            <div class="border rounded p-3 mt-3">

                <div class="d-flex justify-content-between">
                    <strong>{{ cr.dateCreation|date('d/m/Y H:i') }}</strong>
                    <span class="badge bg-secondary">
                        {{ cr.technicien.nom }}
                    </span>
                </div>

                <div class="mt-2" style="white-space: pre-wrap;">
                    {{ cr.description }}
                </div>

                {% if cr.documents is not empty %}
                    <hr>

                    <h6>Documents</h6>

                    <ul class="list-unstyled">
                        {% for doc in cr.documents %}
                            <li>
                                <a href="{{ asset(doc.path) }}" target="_blank">
                                    📎 {{ doc.originalName ?: doc.filename }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

            </div>

        {% endfor %}

    {% endif %}
</div>

</div>

{# ========================= #}
{# MODAL                    #}
{# ========================= #}

{% endblock %}