{% extends 'base.html.twig' %}
{% block title %}Détails de l'intervention
{% endblock %}

{% block body %}
	<div class="container mt-4 p-4 bg-white rounded-xl shadow">

		<div class="d-flex justify-content-between align-items-center mb-4 no-print">
			<h5>Détails de l'intervention</h5>
			<!--bouton pour revenir à l'accueil  -->
			<li style="display: inline; margin: 0 15px;">
				<a href="{{ path('app_home') }}">← Retour à l'accueil</a>
			</li>
<!-- Bouton pour modifier l'intervention -->
			<li style="display: inline; margin: 0 15px;">
			   <a href ="{{ path('app_intervention_edit', {'id': intervention.id}) }}" class="btn btn-primary">Modifier</a>
				
			</li>
			<a href="#" onclick="window.print()" class="btn btn-outline-primary">
				🖨️ Imprimer / PDF
			</a>
		</div>

		<!-- Informations principales -->
		<div class="card p-4 shadow-sm mb-4">
			<h5>
				Informations générales</h5>
			<p>
				<strong>Référence :</strong>
				{{ intervention.reference }}</p>
			<p>
				<strong>Client :</strong>
				{{ intervention.clientNom }}</p>
			<p>
				<strong>Adresse :</strong>
				{{ intervention.adresse }}</p>
			<p>
				<strong>Demande :</strong>
				{{ intervention.demande }}</p>
			<p>
<div 
  class="intervention"
  data-date="{{ intervention.dateIntervention ? intervention.dateIntervention|date('Y-m-d') : '' }}"
  data-start="{{ intervention.heureDebut ? intervention.heureDebut|date('H:i:s') : '' }}"
  data-end="{{ intervention.heureFin ? intervention.heureFin|date('H:i:s') : '' }}"
>
</div>
		</div>
		<!-- Compte rendu -->
		<div class="card p-4 shadow-sm mb-4">
			<h5>
				Compte rendu / Détails</h5>
			<div style="min-height:120mm; border-top:1px solid #ccc; padding:10px; overflow:auto;">
				{% if intervention.detail %}
					<p style="white-space: pre-wrap;">{{ intervention.detail }}</p>
				{% else %}
					<div class="text-muted fst-italic">
						<p>Espace réservé pour le compte rendu manuscrit ou saisi sur tablette.</p>
						<p style="color:#999;">(Ce champ sera imprimé vide sur la version PDF)</p>
					</div>
				{% endif %}
			</div>
		</div>
	<!-- je cache cette partie pour l'instant
