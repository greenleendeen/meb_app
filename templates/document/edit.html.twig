{% extends 'base.html.twig' %}

{% block body %}
			<!--bouton pour revenir à l'accueil  -->
			<li style="display: inline; margin: 0 15px;">
				<a href="{{ path('app_home') }}">← Retour à l'accueil</a>
			</li>
<h1>Modifier le document</h1>

    <a class= "btn btn-primary" href="{{ path('app_intervention_new') }}">Créer une nouvelle intervention</a>
    <table class="table">
<a class="btn btn-primary" href="{{ path('app_document_index') }}">Retour aux documents</a>
<a class="btn btn-secondary" href="{{ path('app_intervention_edit', { id: document.intervention.id }) }}">
    Modifier l’intervention liée
</a>

<div style="display:flex; gap:2rem;">
    <div style="flex:1;">
        {{ form_start(form) }}

        {# Itérer sur les documents existants #}

            <div class="document-entry mb-3">
                {{ form_row(form.type)}}
                {{ form_row(form.filename) }}
                {{ form_row(form.file) }}
                {{ form_row(form.extractedText) }}
            </div>
        {# Si il y a un filename comme champ lors de l'édition  {% if form.filename is defined %}
            {{ form_row(form.filename) }}
        {% endif %} #}
       

            <p>Aucun document associé.</p>


        {# Champ pour ajouter de nouveaux documents {{ form_row(form.newDocuments) }} #}
        

        <button class="btn btn-primary mt-3">Enregistrer</button>
        {{ form_end(form) }}
    </div>
</div>
<div style="flex:1;">
        <h4>Prévisualisation du PDF</h4>

        {% if document and document.filename %}
            <embed src="{{ asset(document.path) }}" type="application/pdf" width="100%" height="600px" />
        {% else %}
            <p>Aucun PDF disponible pour prévisualisation.</p>
        {% endif %}
    </div>
</div>
</div>
{% endblock %}
