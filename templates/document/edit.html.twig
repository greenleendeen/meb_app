{% extends 'base.html.twig' %}

{% block body %}
<h1>Compléter les informations du document</h1>

    <a class= "btn btn-primary" href="{{ path('app_intervention_new') }}">Créer une nouvelle intervention</a>
    <table class="table">

<div style="display:flex; gap:2rem;">
    <div style="flex:1;">
    {{ form_start(form) }}
    {{ form_start(form) }}

{% for docForm in form.documents %}
    <div class="card p-3 mb-3">

        {{ form_row(docForm.file) }}
        {{ form_row(docForm.type) }}
          {{ form_row(docForm.intervention) }}
        {{ form_row(docForm.extractedText) }}
         {% if docForm.filename is defined %}
            {{ form_row(docForm.filename) }}
        {% endif %}       
    </div>
{% endfor %}

            <button class="btn btn-primary">Enregistrer</button>
        {{ form_end(form) }}
    </div>

    <div style="flex:1;">
        <h4>Prévisualisation du PDF</h4>
        <embed src="{{ asset('uploads/documents/' ~ document.filename) }}" 
               type="application/pdf" width="100%" height="600px" />
    </div>
</div>
{% endblock %}
