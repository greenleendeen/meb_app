{% extends 'base.html.twig' %}

{% block title %}liste des documents{% endblock %}

{% block body %}
    <h1>Document index</h1>

  <a class= "btn btn-primary" href="{{ path('app_document_new') }}">Créer un nouveau document</a>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Filename</th>
                <th>Path</th>
                <th>Type</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for document in documents %}
            <tr>
                <td>{{ document.id }}</td>
                <td>{{ document.filename }}</td>
                <td>{{ document.path }}</td>
                <td>{{ document.type.value }}</td>
                <!--    <iframe src="{{ asset(document.path) }}" width="800" height="600"></iframe>
    <img src="{{ asset(document.path) }}" alt="{{ document.filename }}" style="max-width: 500px;"> -->
                <td>
                    <a href="{{ path('app_document_show', {'id': document.id}) }}">show</a>
                    <a href="{{ path('app_document_edit', {'id': document.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

  
{% endblock %}
