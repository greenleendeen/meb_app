{% extends 'base.html.twig' %}

{% block title %}liste des documents{% endblock %}


{% block body %}
			<!--bouton pour revenir à l'accueil  -->
			<li style="display: inline; margin: 0 15px;">
				<a href="{{ path('app_home') }}">← Retour à l'accueil</a>
			</li>

    <h1>Document index</h1>
  <a class= "btn btn-primary" href="{{ path('app_document_new') }}">Créer un nouveau document</a>
    <table class="table">
    
    <a class= "btn btn-primary" href="{{ path('app_intervention_new') }}">Créer une nouvelle intervention</a>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Filename</th>
                <th>Path</th>
                <th>Type</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for document in documents %}
            <tr>
                <td>{{ document.id }}</td>
                <td>{{ document.filename }}</td>
                <td>{{ document.path }}</td>
                <td>{{ document.type.value }}</td>

                <td>
                    <a href="{{ path('app_document_show', {'id': document.id}) }}">show</a>
                    <a href="{{ path('app_document_edit', {'id': document.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

  
{% endblock %}
