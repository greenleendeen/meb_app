{% extends 'base.html.twig' %}

{% block title %}Nouveau document{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Importer un nouveau document</h1>

    <div class="row">
        <!-- Colonne gauche : Intervention -->
        <div class="col-md-6">
            <h3>Infos Intervention</h3>
            {{ form_start(interventionForm) }}
                {{ form_row(interventionForm.clientNom) }}
                {{ form_row(interventionForm.reference) }}
                {{ form_row(interventionForm.adresse) }}
                {{ form_row(interventionForm.demande) }}
                {{ form_row(interventionForm.detail) }}
                {{ form_row(interventionForm.date) }}
                {{ form_row(interventionForm.title) }}
            {{ form_end(interventionForm) }}
        </div>

        <!-- Colonne droite : Document -->
        <div class="col-md-6">
            <h3>Upload Document</h3>
            {{ form_start(documentForm, {'attr': {'id': 'documentForm'}}) }}
                {{ form_row(documentForm.filename) }}
                {{ form_row(documentForm.type) }}

                <button type="button" id="upload_btn" class="btn btn-secondary">Upload</button>
            {{ form_end(documentForm) }}

            <!-- Aperçu PDF -->
            <div id="pdf_preview" class="mt-3 border p-2" style="height: 600px; overflow:auto;">
                {% if document.path %}
                    <iframe src="{{ document.path }}" width="100%" height="100%"></iframe>
                {% else %}
                    <p class="text-muted fst-italic">
                        Le PDF sera affiché ici après l’upload.
                    </p>
                {% endif %}
            </div>

            <!-- Bouton Enregistrer Intervention + Document -->
            <button type="submit" id="save_btn" class="btn btn-primary mt-3">
                Enregistrer tout
            </button>
        </div>
    </div>
</div>

<script>
document.getElementById('upload_btn').addEventListener('click', function(e){
    e.preventDefault();
    const form = document.getElementById('documentForm');
    const data = new FormData(form);

    fetch("{{ path('app_document_upload') }}", {
        method: "POST",
        body: data
    })
    .then(response => response.json())
    .then(json => {
        if(json.success){
            // Mettre à jour l'iframe avec le PDF uploadé
            const preview = document.getElementById('pdf_preview');
            preview.innerHTML = `<iframe src="${json.path}" width="100%" height="100%"></iframe>`;
        } else {
            alert('Erreur lors de l\'upload: ' + json.error);
        }
    })
    .catch(err => alert('Erreur réseau: ' + err));
});
</script>
{% endblock %}
