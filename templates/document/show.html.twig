{% extends 'base.html.twig' %}

{% block title %}Document{% endblock %}

{% block body %}
    <h1>Document</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ document.id }}</td>
            </tr>
            <tr>
                <th>Filename</th>
                <td>{{ document.filename }}</td>
            </tr>
            <tr>
                <th>Path</th>
                <td>{{ document.path }}</td>
            </tr>
            <tr>
                <th>Type</th>
                <td>{{ document.type.value }}</td>
            </tr>
        </tbody>
    </table>

    <p>Type : {{ document.typeLabel }}</p> 
    <iframe src="{{ asset(document.path) }}" width="800" height="600"></iframe>
    <img src="{{ asset(document.path) }}" alt="{{ document.filename }}" style="max-width: 500px;">
    <a href="{{ path('app_document_index') }}">back to list</a>

    <a href="{{ path('app_document_edit', {'id': document.id}) }}">edit</a>

    {{ include('document/_delete_form.html.twig') }}
{% endblock %}
