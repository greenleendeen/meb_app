{% extends 'base.html.twig' %}

{% block title %}Upload Document{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Uploader un document</h1>

    {{ form_start(form) }}
        {{ form_row(form.filename) }}
        {{ form_row(form.type) }}
        <button class="btn btn-primary mt-2">Upload</button>
    {{ form_end(form) }}
</div>
{% endblock %}